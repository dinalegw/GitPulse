# GitPulse Website Environment Variables
# Copy this file to .env.local and fill in the values

# ============================================
# REQUIRED - E2B Sandbox for Playground
# ============================================
# Get your API key from https://e2b.dev/dashboard
E2B_API_KEY=

# Optional: Pre-baked E2B template ID with gitpulse + git pre-installed
# Create a template at https://e2b.dev/dashboard/templates to avoid install-on-boot delay
# Without this, the sandbox will install GitPulse via 'go install' on first boot (~30-60s)
E2B_TEMPLATE_ID=

# ============================================
# OPTIONAL - Playground Configuration
# ============================================
# Sandbox session timeout in seconds (default: 60)
# Increase if interactive commands need more time
PLAYGROUND_MAX_SECONDS=60

# Rate limiting (per IP)
# Requests per minute (default: 5)
RATE_LIMIT_PER_MINUTE=5
# Requests per hour (default: 20)
RATE_LIMIT_PER_HOUR=20

# ============================================
# OPTIONAL - Vercel KV (Upstash Redis) for Rate Limiting
# ============================================
# If not set, rate limiting fails open (allows all requests)
# Get from https://vercel.com/dashboard/stores or https://upstash.com/
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ============================================
# OPTIONAL - Vercel Analytics (included in Vercel projects)
# ============================================
# No configuration needed - enabled automatically on Vercel