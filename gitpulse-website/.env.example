# GitPulse Website Environment Variables
# Copy this file to .env.local and fill in values needed for local development.

# ============================================
# VERCEL SANDBOX PLAYGROUND
# ============================================
# Production deployments on Vercel use Vercel OIDC automatically.
# No E2B API key is required.
#
# For local development, link this directory to the Vercel project and pull
# development environment variables with the Vercel CLI.

# Maximum bootstrap + command execution window in seconds.
# Values are clamped to 30-240 seconds (default: 60).
PLAYGROUND_MAX_SECONDS=60

# Optional source ref override for local/dev smoke tests.
# Vercel deployments automatically prefer VERCEL_GIT_COMMIT_SHA.
GITPULSE_PLAYGROUND_SOURCE_REF=main

# Maximum concurrent playground sessions per client IP (default: 3)
PLAYGROUND_MAX_CONCURRENT_PER_IP=3

# Rate limiting (per IP)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=20

# ============================================
# GITHUB APP CONNECTION
# ============================================
# Register GitPulse as a GitHub App (not a classic OAuth App).
# Production callback URL:
# https://start-gitpulse.vercel.app/api/auth/callback
#
# The callback URL is derived from the incoming request at runtime, so no
# GITHUB_REDIRECT_URI environment variable is required.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# OPTIONAL - Vercel KV / Upstash Redis
# ============================================
# Optional only: used for durable run/audit metadata and distributed rate limiting.
# Sandbox execution and cleanup do NOT depend on KV/Redis.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ============================================
# OPTIONAL - Vercel Analytics
# ============================================
# No configuration needed when enabled for the Vercel project.
